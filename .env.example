# ─── Bot Identity ───
BOT_NAME=Bagah Bot
# Prefix dipisah koma. Kosongkan salah satu entri (contoh di bawah) untuk
# menerima semua tanda baca sebagai prefix.
BOT_PREFIX=,!,.,-,#,•
# Owner numbers (comma-separated, tanpa @s.whatsapp.net)
BOT_OWNER=6283865204595

# ─── Moderation ───
# Blokir otomatis nomor dengan awalan tertentu (comma-separated).
# Contoh: 212,234 — kosongkan untuk menonaktifkan.
BOT_BLOCKED_PREFIXES=

# ─── Pairing ───
PAIRING_ENABLED=true
PAIRING_NUMBER=6283865204595
# Optional: custom 8-digit alphanumeric code (e.g. BAGAHBOT)
PAIRING_CUSTOM_CODE=

# ─── Sticker ───
STICKER_PACKNAME=© Created By
STICKER_AUTHOR=Bagah Bot

# ─── API ───
API_BASE_URL=https://bagahproject.com
API_KEY=

# ─── Mode ───
# true = semua orang bisa pakai, false = owner only
BOT_PUBLIC=true
